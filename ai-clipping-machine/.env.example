# Copy to .env (never share or commit the real one), then: chmod 600 .env

# OpenAI: transcription through the Whisper API (whisper-1). Starts sk-.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs: Forced Alignment (word timing) and speech-to-text for the CTA clip. Starts sk_.
# The key needs BOTH permissions: forced_alignment and speech_to_text.
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
